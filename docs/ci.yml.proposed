# Proposed CI. Copy to .github/workflows/ci.yml.
# Not committed there directly: the token in use lacks GitHub's `workflow` scope.

name: CI

on:
  pull_request:
  push:
    branches: [main]

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci

      - name: Typecheck the app
        run: npm run typecheck
      - name: Typecheck the server
        run: npm run typecheck:server

      # test:bff is not here: it needs a database and a real sky_live_ key,
      # and is run against a live server before release.
      - name: Test
        run: npm test

      - name: Build the web bundle
        run: npm run build:web
